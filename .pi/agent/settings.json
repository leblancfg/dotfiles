{
  "lastChangelogVersion": "0.78.1",
  "quietStartup": true,
  "theme": "ansi-dark",
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "tree",
  "editorPaddingX": 1,
  "transport": "websocket",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "packages": [
    "git:github.com/dbachelder/pi-btw",
    "~/src/github.com/leblancfg/pi-ansi-themes",
    "~/src/github.com/leblancfg/lsp-pi",
    "npm:pi-autoresearch"
  ],
  "httpIdleTimeoutMs": 0,
  "retry": {
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  }
}